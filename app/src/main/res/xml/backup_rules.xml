<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 y anteriores. La cola de ventas sin conexión y el catálogo guardado no se respaldan:
     restaurarlos en otro equipo podría reenviar ventas viejas. La sesión cifrada ya vive en noBackupFilesDir. -->
<full-backup-content>
    <exclude domain="database" path="vilcas_offline.db"/>
    <exclude domain="database" path="vilcas_offline.db-shm"/>
    <exclude domain="database" path="vilcas_offline.db-wal"/>
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y posteriores: mismas exclusiones que backup_rules.xml, para la nube y para la transferencia entre equipos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vilcas_offline.db"/>
        <exclude domain="database" path="vilcas_offline.db-shm"/>
        <exclude domain="database" path="vilcas_offline.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vilcas_offline.db"/>
        <exclude domain="database" path="vilcas_offline.db-shm"/>
        <exclude domain="database" path="vilcas_offline.db-wal"/>
    </device-transfer>
</data-extraction-rules>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#F4FFFA" />
            <stroke android:width="2dp" android:color="#3BBB80" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F4FFFA" />
            <stroke android:width="1.5dp" android:color="#ADE4CF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

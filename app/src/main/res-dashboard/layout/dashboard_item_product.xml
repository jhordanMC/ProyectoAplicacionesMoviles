<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/company_bg_card">
<FrameLayout android:layout_width="match_parent" android:layout_height="90dp" android:background="@drawable/company_bg_icon"><ImageView android:id="@+id/dashboardProductImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/><TextView android:id="@+id/dashboardProductNoImage" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/dashboard_no_image" style="@style/Company.Body"/></FrameLayout>
<TextView android:id="@+id/productName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp" android:textColor="#15964D" android:textStyle="bold"/>
<TextView android:id="@+id/productQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="6dp" android:gravity="center" android:background="@drawable/company_bg_icon" android:textColor="#DD9700" android:textSize="12sp"/>
</LinearLayout>

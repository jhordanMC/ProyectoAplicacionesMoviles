<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" style="@style/Company.Card">
<TextView android:id="@+id/alertTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/company_ic_warning" android:drawablePadding="12dp" android:textSize="17sp" android:textStyle="bold"/>
<TextView android:id="@+id/alertDescription" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Company.Body"/>
<LinearLayout android:id="@+id/alertProducts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>
<include android:id="@+id/dashboardPanelStatus" layout="@layout/dashboard_component_status"/>
</LinearLayout>

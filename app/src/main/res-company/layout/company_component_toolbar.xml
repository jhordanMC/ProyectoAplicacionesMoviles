<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/toolbar_gutter" android:paddingEnd="@dimen/toolbar_gutter" android:background="@color/company_surface">
<ImageButton android:id="@+id/companyMenu" style="@style/Company.ToolbarButton" android:src="@drawable/company_ic_menu" android:contentDescription="@string/company_open_menu"/>
<TextView android:id="@+id/companyTitle" android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" style="@style/Company.SectionTitle" android:text="@string/company_dashboard"/>
<FrameLayout android:layout_width="44dp" android:layout_height="44dp"><ImageButton android:id="@+id/companyNotifications" style="@style/Company.ToolbarButton" android:src="@drawable/company_ic_bell" android:contentDescription="@string/company_notifications"/><View android:id="@+id/companyNotificationBadge" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="top|end" android:layout_margin="3dp" android:background="@drawable/profile_badge" android:visibility="gone" android:importantForAccessibility="no"/></FrameLayout>
<ImageButton android:id="@+id/companyTheme" style="@style/Company.ToolbarButton" android:layout_marginStart="8dp" android:src="@drawable/company_ic_moon" android:contentDescription="@string/company_theme"/>
<FrameLayout android:id="@+id/companyProfileButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/company_profile"><TextView android:id="@+id/companyProfile" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/company_bg_icon" android:gravity="center" android:text="@string/company_avatar" android:textStyle="bold" android:textColor="@color/company_ink" android:clickable="false" android:focusable="false" android:importantForAccessibility="no"/><ImageView android:id="@+id/companyAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/company_bg_icon" android:clipToOutline="true" android:scaleType="centerCrop" android:visibility="gone" android:clickable="false" android:focusable="false" android:importantForAccessibility="no"/></FrameLayout>
</LinearLayout>



<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/sales_notice_detail" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/company_ink"/>
    <TextView android:id="@+id/salesNoticeTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="14dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/vl_text_green"/>
    <LinearLayout android:id="@+id/salesNoticeFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/sales_bg_status" android:backgroundTint="@color/vl_sunken"/>
</LinearLayout>

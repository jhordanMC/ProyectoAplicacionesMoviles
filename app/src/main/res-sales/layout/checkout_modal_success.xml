<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/sales_registered" android:textColor="@color/sales_modal_heading" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/inter"/>
<ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:layout_marginTop="22dp" android:src="@drawable/sales_ic_success" android:contentDescription="@string/sales_registered"/>
<TextView android:id="@+id/successMessage" style="@style/Company.Body" android:gravity="center" android:layout_marginTop="16dp" android:textColor="@color/sales_modal_ink"/>
<TextView android:id="@+id/successId" style="@style/Company.Body" android:gravity="center" android:layout_marginTop="20dp" android:textColor="@color/sales_modal_ink" android:textIsSelectable="true"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/sales_modal_border" android:layout_marginTop="20dp" android:layout_marginBottom="14dp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/successClose" style="@style/SalesModal.Button" android:text="@string/payment_close" android:textColor="@color/sales_modal_secondary_text" android:gravity="start|center_vertical" android:paddingStart="12dp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/successTicket" style="@style/SalesModal.Button" android:text="Imprimir Ticket" android:drawableStart="@drawable/sales_ic_print" android:drawableTint="#FFFFFF" android:drawablePadding="8dp" android:background="@drawable/sales_modal_primary" android:textColor="#FFFFFF" android:gravity="start|center_vertical" android:paddingStart="12dp" android:layout_marginTop="8dp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/successNormal" style="@style/SalesModal.Button" android:text="Formato Normal" android:drawableStart="@drawable/sales_ic_document" android:drawablePadding="8dp" android:gravity="start|center_vertical" android:paddingStart="12dp" android:layout_marginTop="8dp"/>
</LinearLayout>
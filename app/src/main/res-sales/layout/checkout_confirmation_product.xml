<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="8dp">
<ImageView android:id="@+id/confirmationProductImage" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/company_product_preview" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
<TextView android:id="@+id/confirmationProductName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#024B40" android:textSize="12sp" android:textStyle="bold"/>
<TextView android:id="@+id/confirmationProductDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#7A9D92" android:textSize="11sp" android:layout_marginTop="3dp"/>
</LinearLayout></LinearLayout>


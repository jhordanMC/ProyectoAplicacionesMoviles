<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/sales_notice_heading" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/company_ink"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:gravity="center" android:text="@string/sales_notice_caption" android:textSize="13sp" android:textColor="@color/company_muted"/>
    <TextView android:id="@+id/salesNoticeEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="12dp" android:gravity="center" android:text="@string/sales_notice_empty" android:textSize="13sp" android:textColor="@color/company_muted" android:visibility="gone"/>
    <LinearLayout android:id="@+id/salesNoticeList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/salesNoticeMarkAll" style="@style/VilcasModal.Button" android:layout_marginTop="14dp" android:background="@drawable/modal_bg_primary" android:text="@string/sales_notice_mark_all" android:textColor="@android:color/white" android:visibility="gone"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/salesNoticeAnnouncements" style="@style/VilcasModal.Button" android:layout_marginTop="8dp" android:text="@string/sales_notice_announcements"/>
</LinearLayout>

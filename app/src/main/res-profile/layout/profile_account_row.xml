<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="10dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/accountInitials" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/profile_account_avatar" android:fontFamily="@font/inter" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/company_ink" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_marginEnd="6dp" android:orientation="vertical">
        <TextView android:id="@+id/accountName" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/inter" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/company_ink" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/accountCompany" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="@font/inter" android:textSize="11.5sp" android:textColor="#7F948C" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/accountActive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="9dp" android:paddingVertical="3dp" android:background="@drawable/profile_account_active" android:fontFamily="@font/inter" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/vl_text_green" android:text="Activa"/>
    <ImageButton android:id="@+id/accountForget" android:layout_width="40dp" android:layout_height="40dp" android:padding="12dp" android:src="@drawable/company_ic_close" android:tint="#7F948C" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Olvidar esta cuenta"/>
</LinearLayout>

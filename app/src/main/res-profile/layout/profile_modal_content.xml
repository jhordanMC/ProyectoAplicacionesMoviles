<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<FrameLayout android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center" android:layout_marginTop="8dp"><TextView android:fontFamily="@font/inter" android:id="@+id/profileInitials" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center" android:background="@drawable/profile_account_avatar" android:text="@string/company_avatar" android:gravity="center" android:textColor="@color/company_ink" android:textStyle="bold" android:textSize="24sp" android:contentDescription="@string/company_profile"/><ImageView android:id="@+id/profileAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/profile_account_avatar" android:clipToOutline="true" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="Cambiar foto de perfil"/><ImageButton android:id="@+id/profilePhotoButton" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:background="@drawable/profile_account_avatar" android:padding="7dp" android:src="@drawable/inventory_ic_camera" android:tint="@color/vl_text_deep" android:contentDescription="Cambiar foto de perfil"/></FrameLayout>
<TextView android:fontFamily="@font/inter" android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:gravity="center" android:textSize="16sp" android:textColor="@color/company_ink" android:textStyle="bold"/>
<TextView android:fontFamily="@font/inter" android:id="@+id/profileRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textSize="13sp" android:textColor="@color/company_muted"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:layout_marginBottom="12dp" android:background="@color/company_line"/>
<LinearLayout android:id="@+id/profileOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:paddingTop="16dp" android:paddingBottom="20dp">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/profileLogout" style="@style/VilcasModal.Button" android:background="@drawable/modal_bg_danger" android:text="@string/profile_logout" android:textColor="#FF4545" android:drawableStart="@drawable/modal_ic_logout" android:drawableTint="#FF4545" android:paddingStart="20dp" android:paddingEnd="20dp"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/profileClose" style="@style/VilcasModal.Button" android:layout_marginTop="8dp" android:text="@string/modal_close"/>
</LinearLayout></LinearLayout>




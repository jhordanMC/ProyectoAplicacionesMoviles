<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/modal_bg_surface" android:clipToOutline="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<ScrollView android:id="@+id/modalScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:scrollbars="vertical" android:fadeScrollbars="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<include android:id="@+id/modalBrandHeader" layout="@layout/modal_component_brand"/>
<LinearLayout android:id="@+id/modalBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout></ScrollView>
<LinearLayout android:id="@+id/modalPopupActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@color/vl_surface" android:visibility="gone"/>
</LinearLayout>
<ImageButton android:id="@+id/modalCloseIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="16dp" android:padding="9dp" android:background="@drawable/modal_bg_circle" android:src="@drawable/company_ic_close" android:tint="@color/company_ink" android:contentDescription="@string/modal_close_description"/>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/fondoaaas">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="24dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_gutter" android:layout_marginEnd="@dimen/auth_gutter"
            android:id="@+id/borderView" android:background="@drawable/border_gradient" android:padding="3dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="420dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:background="@drawable/bg_card" android:paddingStart="@dimen/auth_inner_gutter"
                android:paddingEnd="@dimen/auth_inner_gutter" android:paddingTop="32dp" android:paddingBottom="36dp">
                <include layout="@layout/component_auth_brand" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp" android:gravity="center"
                    android:text="@string/identity_heading" android:textSize="24sp"
                    android:textStyle="bold" android:textColor="#000000" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:gravity="center"
                    android:text="@string/identity_instructions" android:textSize="15sp" android:textColor="#808080" />
                <com.example.saasvilcas.shared.ui.CodeInputView
                    android:id="@+id/verificationCode" android:layout_width="match_parent"
                    android:layout_height="56dp" android:layout_marginTop="28dp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/codeProgress" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="24dp"
                    android:max="6" android:progress="0" app:trackThickness="4dp"
                    app:trackCornerRadius="2dp" app:trackColor="#E5E5E5" app:indicatorColor="#3BBB80" />
                <TextView android:id="@+id/codeCountdown" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="28dp"
                    android:gravity="center" android:text="@string/code_initial_time"
                    android:textSize="15sp" android:textColor="#808080" />
                <include layout="@layout/auth_component_status" /><TextView android:id="@+id/codeExpiredBack" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:minHeight="48dp" android:gravity="center"
                    android:text="@string/recovery_back" android:textColor="#239A58"
                    android:textStyle="bold" android:visibility="gone"
                    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>



<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/fondoaaas">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_gutter"
            android:layout_marginEnd="@dimen/auth_gutter"
            android:id="@+id/borderView" android:background="@drawable/border_gradient"
            android:padding="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="420dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card"
                android:paddingStart="@dimen/auth_inner_gutter"
                android:paddingEnd="@dimen/auth_inner_gutter"
                android:paddingTop="32dp"
                android:paddingBottom="28dp">
                <include layout="@layout/component_auth_brand" />
                <ImageView android:id="@+id/recoveryIcon" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginTop="24dp" android:padding="14dp" android:src="@drawable/ic_lock" android:background="@drawable/recovery_icon_circle" android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/recoveryHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/recovery_heading"
                    android:fontFamily="@font/inter"
                    android:textSize="18sp"
                    android:textColor="#024B40"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/recoveryInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/recovery_instructions"
                    android:fontFamily="@font/inter"
                    android:textSize="13sp"
                    android:textColor="#7A948B" />
                <FrameLayout android:id="@+id/recoveryEmailField" android:layout_width="match_parent" android:layout_height="wrap_content"><include layout="@layout/component_auth_email"/></FrameLayout>
                <TextView android:id="@+id/recoveryError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="@font/inter" android:textSize="13sp" android:textColor="#EF4444" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
                <include layout="@layout/component_auth_primary_button" />
                <TextView
                    android:id="@+id/recoveryBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@drawable/ic_arrow_back"
                    android:drawablePadding="8dp"
                    android:text="@string/recovery_back"
                    android:textColor="#239A58"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
                <include layout="@layout/component_auth_footer" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>


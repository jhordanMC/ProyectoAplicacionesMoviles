<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/company_canvas">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_gutter">
<include layout="@layout/inventory_component_filter_panel"/>
<TextView android:id="@+id/inventoryStatus" style="@style/Inventory.Text" android:visibility="gone" android:padding="12dp" android:accessibilityLiveRegion="polite"/>
<TextView android:id="@+id/inventoryEmpty" style="@style/Inventory.Text" android:text="@string/inventory_empty" android:gravity="center" android:padding="24dp" android:visibility="gone"/>
<GridLayout android:id="@+id/inventoryProducts" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2"/>
<Button android:id="@+id/inventoryMore" style="@style/Inventory.Action" android:text="Ver más productos" android:visibility="gone"/>
</LinearLayout></ScrollView>

<FrameLayout android:id="@+id/fullscreenFormHost" android:layout_width="match_parent" android:layout_height="match_parent"/></FrameLayout>



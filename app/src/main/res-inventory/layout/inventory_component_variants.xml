<TextView android:id="@+id/inventoryVariantEmpty" style="@style/Inventory.Text" android:text="@string/inventory_variant_empty" android:textColor="#8AA6A0" android:padding="16dp"/>
<LinearLayout android:id="@+id/inventoryVariantRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

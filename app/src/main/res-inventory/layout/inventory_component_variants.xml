<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
<TextView style="@style/Inventory.Text" android:text="@string/inventory_variants" android:textColor="#103D33" android:textStyle="bold"/>

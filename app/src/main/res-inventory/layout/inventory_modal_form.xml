<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/inventoryModalTitle" style="@style/Inventory.Text" android:textColor="#05833B" android:textSize="16sp" android:textStyle="bold" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="18dp" android:paddingStart="@dimen/form_gutter" android:paddingEnd="@dimen/form_gutter"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14024B40"/>
<LinearLayout android:id="@+id/inventoryFormFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/form_gutter" android:paddingEnd="@dimen/form_gutter" android:paddingTop="20dp" android:paddingBottom="20dp"/>
<TextView android:id="@+id/inventoryFormError" style="@style/Inventory.Text" android:textColor="#EF4444" android:visibility="gone" android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:layout_marginBottom="12dp" android:accessibilityLiveRegion="polite"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14024B40"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/form_gutter" android:paddingEnd="@dimen/form_gutter" android:paddingTop="16dp" android:paddingBottom="16dp">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/inventoryFormSave" style="@style/Inventory.Primary" android:text="@string/inventory_save"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/inventoryFormCancel" style="@style/Inventory.Secondary" android:text="@string/cancel" android:layout_marginTop="8dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/inventoryManagementRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>

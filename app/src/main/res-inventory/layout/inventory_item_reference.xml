<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:layout_marginBottom="8dp" android:background="@drawable/inventory_bg_field">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp">
<TextView android:id="@+id/inventoryReferenceName" style="@style/Inventory.Text" android:textColor="#103D33" android:textStyle="bold"/>
<TextView android:id="@+id/inventoryReferenceDetail" style="@style/Inventory.Text" android:textColor="#7AAA95" android:textSize="11sp" android:layout_marginTop="4dp"/>
</LinearLayout>
<ImageButton android:id="@+id/inventoryReferenceEdit" android:layout_width="40dp" android:layout_height="40dp" android:padding="11dp" android:background="@drawable/modal_bg_button" android:src="@drawable/sales_ic_edit" android:tint="#05833B" android:contentDescription="@string/inventory_edit"/>
<ImageButton android:id="@+id/inventoryReferenceDelete" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:padding="11dp" android:background="@drawable/modal_bg_danger" android:src="@drawable/inventory_ic_delete" android:contentDescription="@string/inventory_delete"/>
</LinearLayout>

